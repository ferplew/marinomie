# Imagem de desenvolvimento. O Dockerfile de produção (multi-stage, output
# standalone, usuário não-root) entra junto com docs/deployment.md na Fase 7.
FROM node:22-alpine

WORKDIR /app

# openssl é exigido pelo engine do Prisma em imagens alpine.
RUN apk add --no-cache openssl

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npx prisma generate

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
